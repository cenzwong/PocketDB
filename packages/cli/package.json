{
  "name": "@pocketdb/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "pocketdb": "./bin/pocketdb.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "build": "pnpm --filter @pocketdb/node-client build && vite build",
    "typecheck": "node --check src/cli.mjs && node --check src/postgres-bridge.mjs && node --check src/resp-bridge.mjs && node --check bin/pocketdb.mjs && node --check test/cli.test.mjs && node --check test/resp-bridge.test.mjs && node --check test/browser.mjs",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:browser": "pnpm build && node test/browser.mjs",
    "test:python:browser": "pnpm build && POCKETDB_PYTHON_INTEGRATION=1 node test/browser.mjs"
  },
  "dependencies": {
    "werift": "0.28.0"
  },
  "devDependencies": {
    "@pocketdb/node-client": "workspace:*",
    "pg": "8.23.1",
    "redis": "6.4.0",
    "vite": "8.0.0"
  }
}
