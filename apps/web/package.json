  "dependencies": {
    "@pocketdb/engine-yjs": "workspace:*",
    "@pocketdb/engine-kv": "workspace:*",
    "@pocketdb/engine-pglite": "workspace:*",
    "@pocketdb/engine-sqlite": "workspace:*",
    "@pocketdb/engine-duckdb": "workspace:*",
    "@pocketdb/client": "workspace:*",
